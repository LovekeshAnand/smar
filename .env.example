# Epsilon Engine Local LLM Configuration
EPSILON_CONFIG_PATH=core/config.yaml
EPSILON_TIER=fast
EPSILON_HOST=127.0.0.1
EPSILON_PORT=8088

# SMAR Context Layer
SMAR_DB_PATH=data/smar_memory.db
